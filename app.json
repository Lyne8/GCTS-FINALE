{
  "expo": {
    "name": "egohurry",
    "slug": "egohurry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gcts-icon.jpeg",
    "scheme": "egohurry",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gcts-icon.jpeg",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show your current location on the Fort Portal waste collection map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/gcts-icon.jpeg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/gcts-icon.jpeg"
    },
    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/gcts-icon.jpeg",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
